# itakeit-agent-mem: the agent image plus poma-memory, for agent.memory.
# docker build -f Dockerfile.mem -t itakeit-agent-mem .
FROM cgr.dev/chainguard/go:latest-dev AS builder

LABEL org.opencontainers.image.source="https://github.com/nice-pink/itakeit-agent"

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 ./build

# poma-memory with semantic search, in a venv built on the runtime's own base
# so its python matches. Pinned by commit: 0.5.0 is not on PyPI, and the agent
# needs >= 0.4.0 (the empty gate). The embedding model is fetched here, so the
# agent never downloads at run time (HF_HUB_OFFLINE below).
FROM node:22-slim AS memory

ARG POMA_MEMORY_REF=c2de15e6affb640d8994558d66dc775b21594695
ENV HF_HOME=/opt/hf
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/poma \
 && /opt/poma/bin/pip install --no-cache-dir "poma-memory[semantic] @ git+https://github.com/poma-ai/poma-memory@${POMA_MEMORY_REF}" \
 && /opt/poma/bin/python -c "from model2vec import StaticModel; StaticModel.from_pretrained('minishlab/potion-retrieval-32M')" \
 && chmod -R a+rX /opt/hf /opt/poma

FROM node:22-slim AS runner

LABEL org.opencontainers.image.source="https://github.com/nice-pink/itakeit-agent"

# The CLI version the agent's flags and JSON parsing were verified against.
ARG CLAUDE_CODE_VERSION=2.1.285
# ca-certificates: the Go binary verifies Slack's TLS with the system store.
# python3: poma-memory's interpreter. It is on PATH, like any interpreter in
# the image: read entries refuse interpreters, a plain Bash entry does not.
# No init such as tini: as PID 1 it would hold the Slack tokens in a readable
# /proc/1/environ, which the agent hides for itself (hideEnviron).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && npm cache clean --force
COPY --from=memory /opt/poma /opt/poma
COPY --from=memory /opt/hf /opt/hf
COPY --from=builder /app/bin/itakeit-agent /app/itakeit-agent
# /config/memory is the default agent.memory.dir: mount a volume there, and a
# new named volume takes this directory's owner.
RUN ln -s /opt/poma/bin/poma-memory /usr/local/bin/poma-memory && mkdir -p /config/memory && chown node:node /config/memory
ENV ITAKEIT_AGENT_IMAGE=itakeit-agent-mem HF_HOME=/opt/hf HF_HUB_OFFLINE=1
USER node
ENTRYPOINT [ "/app/itakeit-agent", "-config", "/config/config.yaml" ]
