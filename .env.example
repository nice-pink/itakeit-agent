export AGENT_SLACK_APP_TOKEN=xapp-xxxx
export AGENT_SLACK_BOT_TOKEN=xoxb-xxxx
export CLAUDE_CODE_OAUTH_TOKEN=sk-ant-xxx
export KUBECONFIG=/Users/home/.kube/config
export CLOUDSDK_CONFIG=/Users/home/.config/gcloud
# itakeit binary started by scripts/tmux.sh. Relative paths are from this repo.
export ITAKEIT_BIN=/Users/home/dev/itakeit/bin/itakeit
# itakeit's working directory: holds its .env (SLACK_BOT_TOKEN, SLACK_APP_TOKEN)
# and its database (db_path is relative). Default ../itakeit.
export ITAKEIT_DIR=/Users/home/dev/itakeit
